# Flask security
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
FLASK_ENV=production
FLASK_DEBUG=0

# Local MySQL configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=soadwa_company
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password

# Railway option: set DATABASE_URL to the Railway MySQL connection URL.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
